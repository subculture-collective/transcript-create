FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS gosu-builder

ARG GOSU_VERSION=1.19
ARG GOSU_REVISION=6456aaa0f3c854d199d0f037f068eb97515b7513
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/tianon/gosu.git /src/gosu \
    && cd /src/gosu \
    && git checkout --detach "${GOSU_REVISION}" \
    && test "$(git rev-parse HEAD)" = "${GOSU_REVISION}" \
    && test "$(git describe --exact-match --tags HEAD)" = "${GOSU_VERSION}" \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/gosu ./

FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS walg-builder

ARG WALG_VERSION=v3.0.9-dev.0c3efc9
ARG WALG_REVISION=0c3efc982dccb6f25e5fcdf713ef037a86d62b49
ARG WALG_BUILD_DATE=2026-07-23T00:00:00Z
ARG WALG_X_CRYPTO_VERSION=v0.55.0
ARG WALG_GRPC_VERSION=v1.83.2
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/wal-g/wal-g.git /src/wal-g \
    && cd /src/wal-g \
    && git checkout --detach "${WALG_REVISION}" \
    && test "$(git rev-parse HEAD)" = "${WALG_REVISION}" \
    && go mod edit -require="golang.org/x/crypto@${WALG_X_CRYPTO_VERSION}" \
    && go mod download "golang.org/x/crypto@${WALG_X_CRYPTO_VERSION}" \
    && go mod edit -require="google.golang.org/grpc@${WALG_GRPC_VERSION}" \
    && go mod download "google.golang.org/grpc@${WALG_GRPC_VERSION}" \
    && go mod tidy \
    && test "$(go list -mod=mod -m -f "{{.Version}}" golang.org/x/crypto)" = "${WALG_X_CRYPTO_VERSION}" \
    && test "$(go list -mod=mod -m -f "{{.Version}}" google.golang.org/grpc)" = "${WALG_GRPC_VERSION}" \
    && GOEXPERIMENT=jsonv2 CGO_ENABLED=0 go build -mod=readonly -trimpath \
        -ldflags="-s -w -X github.com/wal-g/wal-g/cmd/pg.buildDate=${WALG_BUILD_DATE} -X github.com/wal-g/wal-g/cmd/pg.gitRevision=${WALG_REVISION} -X github.com/wal-g/wal-g/cmd/pg.walgVersion=${WALG_VERSION}" \
        -o /out/wal-g ./main/pg

FROM postgres:18

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates cron rsync \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gosu-builder /out/gosu /usr/local/bin/gosu
COPY --from=walg-builder /out/wal-g /usr/local/bin/wal-g
RUN gosu nobody true && wal-g --version
