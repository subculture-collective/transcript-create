FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN printf '%s\n' \
        'Acquire::Retries "2";' \
        'Acquire::https::Timeout "60";' \
        > /etc/apt/apt.conf.d/80-retries \
    && printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'attempt=1' \
        'while ! apt-get "$@"; do' \
        '    if [ "$attempt" -ge 12 ]; then' \
        '        exit 1' \
        '    fi' \
        '    attempt=$((attempt + 1))' \
        '    sleep 2' \
        'done' \
        > /usr/local/bin/apt-get-retry \
    && chmod +x /usr/local/bin/apt-get-retry

RUN apt-get-retry update \
    && apt-get-retry install -y --only-upgrade --no-install-recommends \
        cuda-compat-12-8
RUN apt-get-retry install -y --only-upgrade --no-install-recommends \
        cuda-nvrtc-12-8
RUN apt-get-retry install -y --only-upgrade --no-install-recommends \
        libcurand-12-8 \
        libnvjitlink-12-8
RUN apt-get-retry install -y --only-upgrade --no-install-recommends libcufft-12-8
RUN apt-get-retry install -y --only-upgrade --no-install-recommends libcusolver-12-8
RUN apt-get-retry install -y --only-upgrade --no-install-recommends libcusparse-12-8
RUN apt-get-retry install -y --only-upgrade --no-install-recommends \
        libnpp-12-8 \
        cuda-cudart-12-8 \
        cuda-nvtx-12-8 \
        cuda-opencl-12-8 \
        cuda-toolkit-config-common \
        cuda-toolkit-12-config-common \
        cuda-toolkit-12-8-config-common \
        libcufile-12-8 \
        libnvfatbin-12-8 \
        libnvjpeg-12-8
RUN apt-get-retry upgrade -y --no-install-recommends
RUN apt-get-retry install -y --no-install-recommends \
        ffmpeg \
        python3 \
        python3-pip \
        curl \
        ca-certificates \
        unzip \
    && ffmpeg -version \
    && ffprobe -version \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deno.land/install.sh | sh \
    && mv /root/.deno/bin/deno /usr/local/bin/deno \
    && chmod +x /usr/local/bin/deno \
    && deno --version

WORKDIR /app
COPY requirements-api.txt requirements-ingest.txt constraints.txt ./
RUN pip3 install --upgrade pip==26.2 setuptools==83.0.0 wheel==0.47.0
RUN pip3 install -c constraints.txt -r requirements-api.txt \
    && pip3 check
RUN pip3 install -c constraints.txt ctranslate2==4.6.0 \
    && pip3 check
RUN pip3 install -c constraints.txt faster-whisper==1.2.0 \
    && pip3 check

RUN pip3 uninstall --yes pip && apt-get purge -y python3-pip

COPY app ./app
COPY worker ./worker

CMD ["python3", "-m", "worker.loop"]
